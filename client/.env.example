# Build-time URL of the Express API on Azure App Service.
# Example: https://vaultpay-demo.azurewebsites.net
VITE_API_URL=https://YOUR-APP.azurewebsites.net

# GitHub project pages base path, e.g. /vaultpay-web/
# Leave as ./ for user/org pages or when opening dist/ locally.
# VITE_BASE=/your-repo-name/
