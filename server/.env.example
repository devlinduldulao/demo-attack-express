# Copy to .env if you want — the server also reads process env directly.
PORT=4000

# Weak tutorial default for the vulnerable demo.
JWT_SECRET=supersecret123

# Local default matches HOW-TO-ATTACK. Use production on cloud deploys.
NODE_ENV=development

# Vulnerable demo body cap (misconfig vs express.json 100kb default).
BODY_LIMIT=50mb

# Gate public deploys (attack: --gate=TOKEN or DEMO_GATE_TOKEN env).
# DEMO_GATE_TOKEN=

# Optional: require X-VaultPay-Reset for POST /api/demo/reset
# DEMO_RESET_TOKEN=
